# ── Server ──────────────────────────────────────────────
LORE_PORT=4737
# Interface for the HTTP API + chat UI (default 0.0.0.0)
# LORE_HOST=0.0.0.0
# Break-glass admin key (bootstrap, scripts): pushes anywhere, uses the admin API. Required.
# Generate one: openssl rand -hex 32  (weak keys are rejected when NODE_ENV=production,
# which is the default in the Docker image)
LORE_API_KEY=
DATABASE_URL=postgres://lore:lore@localhost:5433/lore
# First admin of a password install, created on `lore serve` when there are no users yet.
# Set both or neither; the password needs at least 12 characters.
# LORE_ADMIN_LOGIN=admin
# LORE_ADMIN_PASSWORD=
# Force the Secure cookie flag (auto when requests arrive over https)
# LORE_COOKIE_SECURE=false
# Proxies trusted for X-Forwarded-For / X-Forwarded-Proto (client address of the sign-in limits):
# unset or false = none (the TCP peer is the client), or comma-separated proxy IPs/CIDRs (hop counts
# are refused). Set it behind a reverse proxy, never when clients reach Lore directly.
# LORE_TRUST_PROXY=172.16.0.0/12
# Signs known-device cookies of password sign-in (≥ 32 characters; default: derived from LORE_API_KEY)
# LORE_DEVICE_COOKIE_SECRET=
# Days a `lore login` token (cli-<hostname>) lives, 1-3650 (Tokens page tokens never expire)
# LORE_CLI_TOKEN_TTL_DAYS=90
# Absolute lifetime in hours of a single sign-on web session, 1-720: after it the person signs in
# at the provider again (groups and role are re-read). Password sessions only slide (7 days).
# LORE_SSO_SESSION_MAX_HOURS=24
# Extra Origins accepted on state-changing requests (CSRF check), comma-separated
# LORE_ALLOWED_ORIGINS=
# Library that receives published chats
# LORE_INSIGHTS_LIBRARY=insights
LORE_STORAGE_PATH=./storage
# LOG_LEVEL=info

# ── Single sign-on (OIDC) ───────────────────────────────
# SSO is on when all three of OIDC_ISSUER, OIDC_CLIENT_ID and OIDC_CLIENT_SECRET are set (a partial
# set is a startup error). The web UI then signs in with SSO only and LORE_ADMIN_* are ignored.
# Register the redirect URI ${PUBLIC_URL}/api/auth/sso/callback at the provider.
# PUBLIC_URL=https://lore.example.com
# OIDC_ISSUER=https://id.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# Members of OIDC_LOGIN_GROUP may sign in; members of OIDC_ADMIN_GROUP are admins (re-synced on every sign-in)
# OIDC_LOGIN_GROUP=lore-users
# OIDC_ADMIN_GROUP=lore-admins
# OIDC_SCOPES=openid profile email groups
# OIDC_GROUPS_CLAIM=groups
# Allow a plain-http issuer (private network, tests only)
# OIDC_ALLOW_INSECURE=false

# ── MCP over HTTP (lore serve) ──────────────────────────
LORE_MCP_PORT=4738
# Interface to bind (default 127.0.0.1)
# LORE_MCP_HOST=127.0.0.1
# MCP clients send a personal sk_ token (Tokens page) or LORE_API_KEY.
# The MCP URL shown in the Tokens page's `claude mcp add` command:
# LORE_MCP_PUBLIC_URL=http://localhost:4738/mcp
# Comma-separated Host header allowlist (default: loopback names when bound to loopback)
# LORE_MCP_ALLOWED_HOSTS=localhost:4738,127.0.0.1:4738
# Comma-separated browser Origin allowlist (default: none)
# LORE_MCP_ALLOWED_ORIGINS=

# ── Embeddings ──────────────────────────────────────────
# openai-compatible | ollama | hash (offline, deterministic) | none (full-text only)
LORE_EMBEDDING_PROVIDER=hash
# openai-compatible: model is required; endpoint defaults to LLM_BASE_URL, then OpenRouter; key to LLM_API_KEY
# LORE_EMBEDDING_MODEL=openai/text-embedding-3-small
# LORE_EMBEDDING_BASE_URL=
# LORE_EMBEDDING_API_KEY=
# LORE_OLLAMA_URL=http://localhost:11434
# LORE_OLLAMA_MODEL=nomic-embed-text
# Minimum cosine similarity for vector hits (default: provider-specific, 0.2 for hash, 0 otherwise)
# LORE_VECTOR_MIN_SCORE=

# ── LLM (chat answers, query term extraction, link enrichment, publishing) ──
# Any OpenAI-compatible endpoint. Without a key or base URL the chat shows search results only.
# LLM_API_KEY=
# LLM_BASE_URL=https://openrouter.ai/api/v1   # default; e.g. http://localhost:11434/v1 for Ollama
# LLM_MODEL=anthropic/claude-sonnet-4.5       # required once LLM_API_KEY or LLM_BASE_URL is set

# ── Search ──────────────────────────────────────────────
# Drop results below topScore × factor in FTS/vector-only mode (0.0–1.0, default 0.80)
# LORE_SEARCH_DROP_FACTOR=0.80

# ── Prompts ─────────────────────────────────────────────
# Directory whose files override prompts/ by relative name (missing files fall back)
# LORE_PROMPTS_DIR=./my-prompts
# Location of the default templates if Lore is not started from the repo root
# LORE_DEFAULT_PROMPTS_DIR=
# Global template variables, e.g. {{example_library}}
# LORE_PROMPT_VAR_ASSISTANT_NAME=Lore
# LORE_PROMPT_VAR_EXAMPLE_LIBRARY=orders-api

# ── CLI (lore login / push / images / namespace / project-key) ──
# Server URL (default: the URL stored by `lore login`, else http://localhost:4737)
# LORE_URL=http://localhost:4737
# Token: a personal sk_ token, or a project key lpk_ in CI. Takes precedence over the
# credentials file of `lore login` (~/.config/lore/credentials.json).
# LORE_TOKEN=
# GIT_BRANCH=

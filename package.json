{
  "name": "lore",
  "version": "1.0.0",
  "description": "Living documentation for your services: docs rebuilt on every merge, searchable by people (chat with citations) and agents (MCP)",
  "main": "dist/cli.js",
  "bin": {
    "lore": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/main.ts serve",
    "dev:watch": "tsx watch src/main.ts serve",
    "build": "node build.mjs",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "vitest run && vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "demo": "tsx scripts/demo.ts",
    "generate:example": "tsx examples/generator/generate.ts",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "lint": "oxlint src test e2e",
    "verify": "npm run typecheck && npm run lint && npm run arch && npm test && npm run build"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.3",
    "@highlightjs/cdn-assets": "^11.12.0",
    "@modelcontextprotocol/sdk": "^1.10.2",
    "@types/diff": "^7.0.2",
    "commander": "^12.1.0",
    "diff": "^9.0.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.2.1",
    "gray-matter": "^4.0.3",
    "mermaid": "^11.17.2",
    "openai": "^6.33.0",
    "openid-client": "^6.8.8",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.2",
    "dependency-cruiser": "^18.7.0",
    "dompurify": "^3.4.17",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "marked": "^18.1.2",
    "oxlint": "^1.90.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "vitest": "^4.1.2"
  },
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ai-pipes/lore.git"
  }
}
